# DOMAIN con un dominio (app.tuempresa.com): Caddy consigue solo el certificado HTTPS (Let's Encrypt).
# DOMAIN=:80 (detrás de Cloudflare Tunnel, que ya pone el HTTPS): Caddy sirve HTTP plano y no pide ningún certificado.
{
	email {$CADDY_EMAIL}
}

{$DOMAIN} {
	encode gzip

	handle /api/* {
		reverse_proxy api:8080
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
