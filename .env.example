# Postgres
POSTGRES_USER=viariato
POSTGRES_PASSWORD=viariato_dev_password
POSTGRES_DB=viariato
POSTGRES_PORT=5432

# Backend (Viariato.Api)
ConnectionStrings__Postgres=Host=postgres;Port=5432;Database=viariato;Username=viariato;Password=viariato_dev_password

Jwt__Issuer=viariato.app
Jwt__Audience=viariato.app
Jwt__SigningKey=CHANGE_ME_MINIMUM_32_BYTES_LONG_DEV_SECRET
Jwt__AccessTokenMinutes=15
Auth__RefreshTokenDays=30

Cors__AllowedOrigins=http://localhost:5173

Bootstrap__AdminEmail=admin@viariato.app
Bootstrap__AdminPassword=ChangeMe123456!

ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:8080

# Frontend
VITE_API_URL=http://localhost:8080
