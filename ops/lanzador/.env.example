# Copia este archivo como ".env" (está ignorado por git) y rellénalo. Las claves NUNCA van en el repositorio ni en el catálogo.

# Solo para un lanzador en una máquina que no es la de Viriato (en la de Viriato ya viene en docker-compose.prod.yml, sin .env).
# Dónde está Viriato visto desde el contenedor:
#  - en el mismo PC, con su compose normal (puerto 8080 de la API): http://host.docker.internal:8080
#  - en producción detrás de Cloudflare Tunnel: la dirección pública, p. ej. https://viriato.tudominio.com
VIRIATO_URL=http://host.docker.internal:8080

# Carpeta de este PC con el catálogo (robots.json) y una subcarpeta por robot.
ROBOTS_DIR=./robots

# «ligero» (solo .NET) o «navegador» (además Edge y pantalla virtual; solo linux/amd64).
LANZADOR_IMAGEN=ligero

# El tope del contenedor entero: el lanzador y los robots que tenga en marcha a la vez.
LANZADOR_MEMORIA=3g
LANZADOR_CPUS=2

# Una variable por robot con la clave de su despliegue (Viriato → RPA → Despliegues; se muestra una sola vez). El nombre de la
# variable es el que pone "claveEnv" en el catálogo.
EXTRACTOR_API_KEY=
CREADOR_API_KEY=

# Lo que el catálogo de ejemplo pasa a los robots (${...} en "entorno").
TRADEPLACE_CREDENCIAL=tradeplace_credentials
VISTA_URL_PUBLICA=http://localhost:6080/vnc.html
