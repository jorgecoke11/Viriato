# Copia este archivo como ".env" junto a docker-compose.prod.yml y rellena
# los valores reales. NUNCA commitees el ".env" con secretos de verdad.

# Cómo se llega a la app. Dos formas (guía completa: docs/despliegue-en-real.md):
#
#  A) Con Cloudflare Tunnel (sin abrir puertos del router): DOMAIN=:80, PUBLIC_URL con la dirección pública,
#     y el token del túnel. Se levanta con  --profile tunnel.
#  B) Con un servidor con IP pública: DOMAIN=app.tuempresa.com y su DNS apuntando ya a la IP ANTES de levantar "web";
#     Caddy pide el certificado TLS (Let's Encrypt) solo al arrancar. PUBLIC_URL se puede dejar vacío.
DOMAIN=:80
# La dirección con la que entra la gente y los robots (con https://). Vacío: https://$DOMAIN.
PUBLIC_URL=https://viriato.tu-dominio.com

# Puertos del PC donde escucha "web". Con Cloudflare Tunnel no hacen falta (el túnel entra por la red de Docker): solo sirven para
# probar en local. Si Windows tiene ocupado el 80 (error "socket no permitido por sus permisos"), descomenta y usa otros.
# HTTP_PORT=8088
# HTTPS_PORT=8443
# Token del túnel de Cloudflare (Zero Trust → Networks → Tunnels → tu túnel). Es un secreto: solo aquí.
CLOUDFLARE_TUNNEL_TOKEN=
# Email para avisos de Let's Encrypt (solo se usa en la forma B).
CADDY_EMAIL=tu-email@tu-dominio.com

# Dónde guarda tu PC los archivos (documentos y evidencias) y las copias de seguridad.
# Usa barras normales (/) también en Windows. Si tienes un segundo disco, mejor ahí
# (p. ej. D:/ViriatoData/...): si falla el disco del sistema no pierdes todo a la vez.
# Dentro verás: almacenamiento/documentos/AÑO/MES/CASO/ y almacenamiento/evidencias/AÑO/MES/CASO/
STORAGE_HOST_PATH=C:/ViriatoData/almacenamiento
BACKUPS_HOST_PATH=C:/ViriatoData/backups

# Copia diaria. Hora local (0-23), días de copias que se conservan y si las evidencias
# (pesadas) también se suben fuera del PC. Los documentos y la base de datos siempre se suben.
TZ=Europe/Madrid
BACKUP_HOUR=3
BACKUP_KEEP_DAYS=14
BACKUP_INCLUDE_EVIDENCIAS=false
# Destino SFTP de las copias (p. ej. el hosting de Hostinger: host y puerto SSH de hPanel,
# el puerto suele ser 65002). Déjalo vacío para copiar solo dentro del PC.
SFTP_HOST=
SFTP_PORT=65002
SFTP_USER=
SFTP_PASSWORD=
SFTP_REMOTE_DIR=viriato-backups

# Postgres
POSTGRES_USER=viariato
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=viariato

# MinIO — opcional, solo si vas a usar almacenamiento S3 para documentos
# (ver StorageConfigsPage en el front). Si no lo vas a usar todavía, puedes
# dejar estos valores tal cual: el servicio igualmente no se expone fuera
# de la red interna.
MINIO_ROOT_USER=viariato
MINIO_ROOT_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Backend (Viariato.Api)
ConnectionStrings__Postgres=Host=postgres;Port=5432;Database=viariato;Username=viariato;Password=CHANGE_ME_STRONG_PASSWORD

Jwt__Issuer=viariato.app
Jwt__Audience=viariato.app
# Genera uno nuevo y distinto al de desarrollo, por ejemplo con:
#   openssl rand -base64 32
Jwt__SigningKey=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_BASE64_32
Jwt__AccessTokenMinutes=15

# Clave maestra que cifra las contraseñas guardadas en Credenciales: base64 de EXACTAMENTE 32 bytes.
# Genérala una vez (PowerShell):
#   [Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(32))
# o con openssl:  openssl rand -base64 32
# GUÁRDALA FUERA DEL SERVIDOR (gestor de contraseñas): no va en la base de datos ni en las copias de
# seguridad, y sin ella las credenciales guardadas son irrecuperables. Cambiarla las deja inservibles.
Credenciales__ClaveCifrado=CHANGE_ME_BASE64_DE_32_BYTES
Auth__RefreshTokenDays=30

Bootstrap__AdminEmail=admin@tu-dominio.com
Bootstrap__AdminPassword=CHANGE_ME_STRONG_PASSWORD

Markets__UserAgent=ViariatoMarketsBot/1.0 (+https://tu-dominio.com)
Markets__SyncRequestDelayMs=300
Markets__DiscountRatePercent=4.4

ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:8080

# Opcional — ver comentario de build args en docker-compose.prod.yml.
APP_VERSION=
GIT_SHA=
